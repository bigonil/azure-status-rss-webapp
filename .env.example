EMAIL_NOTIFICATIONS_ENABLED=true
ALERT_EMAIL_TO=luca.bigoni@gruppohera.it
ALERT_EMAIL_FROM=azure-alerts@your-domain.tld
NOTIFY_POLL_MS=300000
NOTIFY_MAX_ITEM_AGE_HOURS=72

# SMTP example (Microsoft 365 / relay / provider SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-user@your-domain.tld
SMTP_PASS=replace-me

# Optional: override keyword list for Europe detection (comma-separated)
# EUROPE_REGION_KEYWORDS=europe,west europe,north europe,italy north,france central,uk south
