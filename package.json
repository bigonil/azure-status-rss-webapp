{
  "name": "azure-status-rss-webapp",
  "version": "1.0.0",
  "private": true,
  "description": "Webapp Docker per visualizzare i feed RSS ufficiali Azure Status relativi a fault/incident",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:mock": "node scripts/start-local-mock-demo.js",
    "mock:smtp": "node scripts/mock-smtp-server.js",
    "test:notifier:mock": "node scripts/verify-notifier-local-mock.js",
    "mcp:start": "node mcp-server/server.mjs",
    "mcp:doctor": "node mcp-server/server.mjs --doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.4.1",
    "nodemailer": "^8.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "smtp-server": "^3.13.6"
  }
}
